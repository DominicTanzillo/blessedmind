# Supabase project — same values as the app's root .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The account the server signs in as. Required since sql/002_require_auth.sql:
# the anon key alone satisfies no policy, so reads come back empty.
# This file is gitignored and never leaves the machine.
SUPABASE_EMAIL=the-email-of-your-supabase-auth-user
SUPABASE_PASSWORD=that-account-s-password
